# ===== Bocchi 工具台 后端环境配置 =====
# 复制本文件为 .env 后按需修改，切勿把 .env 提交到 Git。

# 会话签名密钥（务必改成随机长字符串）
# 生成：python3 -c "import secrets; print(secrets.token_hex(32))"
NOVA_SECRET_KEY=replace-with-a-random-secret

# SQLite 数据库路径（相对 backend 目录）
NOVA_DATABASE=./data/nova.db

# 允许跨域的前端来源，逗号分隔
NOVA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 内置演示账号（登录页可一键体验，无需注册）
NOVA_DEMO_USER_ID=usr_demo
NOVA_DEMO_EMAIL=demo@example.com
NOVA_DEMO_PASSWORD=demo123
NOVA_DEMO_USER_NAME=演示用户
NOVA_DEMO_USER_ROLE=访客
NOVA_ACCESS_TOKEN_MAX_AGE=3600

# 监听地址与端口
NOVA_HOST=127.0.0.1
NOVA_PORT=8000
NOVA_DEBUG=true

# ===== 邮件发送（注册 / 重置密码验证码）=====
# 本项目不自带 SMTP，而是通过一个兼容的邮件 API 发送。
# 推荐使用开源项目 cloudflare_temp_email 自建免费临时域名邮箱：
#   https://github.com/dreamhunter2333/cloudflare_temp_email
# 部署后在它的前端创建/登录一个邮箱，复制该邮箱的「地址 JWT」填到
# NOVA_EMAIL_API_TOKEN；若站点启用了私有密码，再填入 NOVA_EMAIL_CUSTOM_AUTH。
# 该服务的 /api/send_mail 请求体与本项目 email_service.py 完全一致。
NOVA_EMAIL_API_URL=https://your-mail-api.example.com/api/send_mail
NOVA_EMAIL_API_TOKEN=
NOVA_EMAIL_CUSTOM_AUTH=
NOVA_EMAIL_FROM_NAME=Bocchi
# 开发环境置 true 可在无邮件服务时直接把验证码打印到后端日志
NOVA_EMAIL_DEBUG=true
NOVA_REGISTRATION_CODE_MAX_AGE=600

# ===== 文件快递柜 =====
NOVA_FILEBOX_DIR=./data/filebox
NOVA_FILEBOX_MAX_UPLOAD_BYTES=104857600
NOVA_FILEBOX_MAX_TEXT_BYTES=227328

# ===== 管理员 =====
# 首次登录管理员后台会强制修改默认密码
NOVA_ADMIN_USERNAME=admin
NOVA_ADMIN_PASSWORD=admin
NOVA_ADMIN_TOKEN_SALT=bocchi-admin-token
NOVA_ADMIN_ACCESS_TOKEN_MAX_AGE=3600
